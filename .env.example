# Frontend (todas as VITE_* viram público no bundle)
VITE_WHATSAPP_NUMBER=5599999999999
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ATENÇÃO: a STRIPE_SECRET_KEY e o STRIPE_WEBHOOK_SECRET NUNCA vão neste arquivo.
# Eles são configurados como secrets do Supabase Edge Functions:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_xxx
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
